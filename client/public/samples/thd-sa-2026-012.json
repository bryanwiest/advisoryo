    "notes": [
      {
        "category": "summary",
        "text": "SmartHeat controllers install firmware images without checking their signature. An attacker with access to the local network can install modified firmware. Firmware 5.2.0 verifies signatures before installing."
      }
    ],
    "publisher": {
      "category": "vendor",
      "name": "Thermo Devices AG",
      "namespace": "https://thermo-devices.example"
    },
    "title": "Missing firmware signature check in SmartHeat controller",
