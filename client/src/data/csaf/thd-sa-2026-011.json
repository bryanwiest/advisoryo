  "vulnerabilities": [
    {
      "cve": "CVE-2026-39877",
      "cwe": {
        "id": "CWE-400",
        "name": "Uncontrolled Resource Consumption"
      },
      "notes": [
        {
          "category": "description",
          "text": "The MQTT client does not limit the length of the remaining-length field. A broker or attacker in the same network can send a packet that exhausts memory and crashes the controller."
        }
      ],
      "product_status": {
        "known_affected": [
          "CSAFPID-0001",
          "CSAFPID-0002"
        ]
      },
      "remediations": [
        {
          "category": "mitigation",
          "details": "Connect the controller only to a trusted MQTT broker and block port 1883 from untrusted networks.",
          "product_ids": [
            "CSAFPID-0001",
            "CSAFPID-0002"
          ]
        },
