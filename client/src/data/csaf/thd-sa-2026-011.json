    "notes": [
      {
        "category": "summary",
        "text": "A malformed MQTT packet makes the SmartHeat controller restart in a loop. The heating keeps running in its last mode, but remote control and monitoring are unavailable until the attack stops. A fix is in progress."
      }
    ],
    "publisher": {
      "category": "vendor",
      "name": "Thermo Devices AG",
      "namespace": "https://thermo-devices.example"
    },
    "title": "Denial of service in SmartHeat controller MQTT client",
