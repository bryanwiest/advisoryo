    "notes": [
      {
        "category": "summary",
        "text": "The OPC UA server of PlantLink accepts sessions with the security policy None even if the operator disabled it. An attacker in the plant network can read and write process values. A fix is in progress."
      }
    ],
    "publisher": {
      "category": "vendor",
      "name": "Kessler Maschinenbau KG",
      "namespace": "https://kessler.example"
    },
    "title": "Authentication bypass in PlantLink OPC UA server",
